NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

JWT_SECRET=cambiar-por-un-secreto-largo-y-seguro
JWT_EXPIRES_IN=8h
SESSION_COOKIE_NAME=vet_session
PASSWORD_RESET_MINUTES=30
BCRYPT_ROUNDS=10

# URLs publicas usadas dentro del correo de recuperacion.
CLIENT_APP_URL=http://localhost:4000
EMPLOYEE_APP_URL=http://localhost:4000

# SMTP. Para puerto 465 usar SMTP_SECURE=true; para 587 usar false y STARTTLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=notificaciones@example.com
SMTP_PASSWORD=cambiar-por-secreto-del-proveedor
MAIL_FROM="Veterinaria El Ganadero <notificaciones@example.com>"

# SQL Server es obligatorio. En Windows se recomienda autenticacion integrada.
DB_ENABLED=true
DB_AUTH=windows
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=VeterinariaDB
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true
